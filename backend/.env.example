# Copy this file to ".env" (in this same backend folder) and fill in your key.
# NEVER commit .env or share your key. It stays on the backend only.

# Your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# The Groq model to use. Must support tool calling.
# Alternative if this one is busy or rate-limited: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# groq = the real model (needs internet + key)
# mock = an offline fake model, for when the internet or Groq is down
LLM_PROVIDER=groq

# true  = hide personal data (emails, phone numbers, card numbers, Aadhaar,
#         PAN, UPI IDs, API keys) from the model; see app/masking.py
# false = send messages to the model exactly as typed
MASK_PII=true
